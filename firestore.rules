rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Read-only without auth — each recipe is a separate document: /{cookbookId}/{recipeId}
    // Obscurity via secret cookbookId; no allowlist, no writes.
    // Redeploy with: firebase deploy --only firestore:rules --project yes-chef-cookbook
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
