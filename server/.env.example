# Copy to .env (gitignored)
FIREBASE_PROJECT_ID=yes-chef-cookbook
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
MCP_TOKEN=your-mcp-token-here
PORT=8080

# Auth — MCP HTTP endpoints require `Authorization: Bearer <MCP_TOKEN>`
# Token is stored in Secret Manager `mcp-token` (not RECIPES_COLLECTION).
# Health checks (/, /health) are unauthenticated. stdio transport bypasses HTTP auth.
# Example: MCP_TOKEN=deafening-gnarly-dining-mcp-token -> token "deafening-gnarly-dining-mcp-token"
# To disable auth locally (emulator): MCP_NO_AUTH=1

# For local emulator
# FIRESTORE_EMULATOR_HOST=localhost:8080
# MCP_NO_AUTH=1  # uncomment to disable auth locally

# MCP
# MCP_TRANSPORT=http  # http (default) or stdio
# OAUTH_ISSUER=https://yes-chef-cookbook-158345618336.europe-west1.run.app
