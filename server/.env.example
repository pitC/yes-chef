# Copy to .env (gitignored)
FIREBASE_PROJECT_ID=yes-chef-cookbook
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
PORT=8080

# Auth — MCP HTTP endpoints require `Authorization: Bearer <cookbook-code>` (collection name)
# Health checks (/, /health) are unauthenticated. stdio transport uses COOKBOOK_CODE.
# To disable auth locally (emulator): MCP_NO_AUTH=1

# Firestore server identity — the backend signs into Firebase Auth as a
# dedicated service user; rules allow traffic only from its `isServer` claim.
# In Cloud Run these come from Secret Manager (see terraform/secrets.tf +
# run.tf); .env is for local runs against the real project only.
# For the local emulator, skip these and use MCP_NO_AUTH=1 instead.
# FIREBASE_CONFIG_JSON={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
# SERVER_AUTH_EMAIL=backend-service@example.com
# SERVER_AUTH_PASSWORD=...

# For local emulator
# FIRESTORE_EMULATOR_HOST=localhost:8080
# MCP_NO_AUTH=1  # uncomment to disable auth locally (skips server sign-in)

# stdio mode requires cookbook code:
# COOKBOOK_CODE=my-cookbook-code
# npm run dev:stdio

# MCP
# MCP_TRANSPORT=http  # http (default) or stdio
# OAUTH_ISSUER=https://yes-chef-cookbook-158345618336.europe-west1.run.app
