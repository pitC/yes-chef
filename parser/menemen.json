  "steps": [
    {
      "id": "step_1",
      "order": 1,
      "title": "Beat eggs",
      "text": "Put [eggs] into a bowl with half a teaspoon of salt. Lightly beat, just to break up the yolks, and set aside.",
      "timer": null,
      "ingredientRefs": ["ing_1"]
    },
    {
      "id": "step_2",
      "order": 2,
      "title": "Soften onions",
      "text": "Put the oil into a medium frying pan on a medium-high heat. Add [onion] and [garlic] and cook for five minutes, stirring a few times, until softened and starting to colour.",
      "timer": { "durationSeconds": 300, "label": "Cook onions" },
      "ingredientRefs": ["ing_3", "ing_4"]
    },
    {
      "id": "step_3",
      "order": 3,
      "title": "Bloom spices",
      "text": "Add the spices, [tomato paste] and an eighth of a teaspoon of salt and cook for two minutes, until fragrant.",
      "timer": { "durationSeconds": 120, "label": "Cook spices" },
      "ingredientRefs": ["ing_5", "ing_6", "ing_7", "ing_8"]
    },
    {
      "id": "step_4",
      "order": 4,
      "title": "Cook tomatoes",
      "text": "Add [cherry tomatoes] and 60ml of water, then cook, uncovered, for 10 minutes until the tomatoes have broken down. Squish them with the back of a spoon if they need a bit of help.",
      "timer": { "durationSeconds": 600, "label": "Cook tomatoes" },
      "ingredientRefs": ["ing_9"]
    },
    {
      "id": "step_5",
      "order": 5,
      "title": "Finish and serve",
      "text": "Remove from the heat and swirl in [eggs], using a wooden spoon or spatula and moving the pan gently until just set. Spoon over the [double cream], sprinkle over [coriander leaves] and serve straight from the pan.",
      "timer": null,
      "ingredientRefs": ["ing_1", "ing_10", "ing_11"]
    }
  ],
