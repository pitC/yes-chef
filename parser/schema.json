{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Yes Chef Recipe Schema",
  "required": [
    "title",
    "sourceUrl",
    "sourceName",
    "tags",
    "servings",
    "timing",
    "ingredients",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Auto-generated document ID from Firestore"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Recipe title"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "description": "Original recipe URL"
    },
    "sourceName": {
      "type": "string",
      "description": "Source website/domain name"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Flat array of tags (dietary, meal type, cuisine)"
    },
    "servings": {
      "type": "object",
      "required": ["base", "unit"],
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 1,
          "description": "Base number of servings"
        },
        "unit": {
          "type": "string",
          "enum": ["people", "servings", "portions"],
          "description": "Serving unit"
        }
      }
    },
    "timing": {
      "type": "object",
      "required": ["prepMinutes", "cookMinutes", "totalMinutes"],
      "properties": {
        "prepMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "cookMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "totalMinutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "amount", "unit"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ing_\\d+$",
            "description": "Auto-generated ingredient ID"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "enum": ["g", "kg", "ml", "l", "tsp", "tbsp", "piece", "pinch"]
          },
          "notes": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^step_\\d+$",
            "description": "Auto-generated step ID"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "timer": {
            "type": ["object", "null"],
            "properties": {
              "durationSeconds": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["durationSeconds", "label"]
          },
          "ingredientRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ing_\\d+$"
            },
            "description": "References to ingredient IDs relevant to this step"
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}