{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe",
  "type": "object",
  "required": ["title", "ingredients", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Auto-generated document ID"
    },
    "title": {
      "type": "string",
      "description": "Recipe title"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "description": "Original source URL"
    },
    "sourceName": {
      "type": "string",
      "description": "Source name/publication"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Flat array of dietary and meal-type labels"
    },
    "servings": {
      "type": "object",
      "required": ["base", "unit"],
      "properties": {
        "base": {
          "type": "number",
          "description": "Base serving count"
        },
        "unit": {
          "type": "string",
          "enum": ["people", "servings"],
          "description": "Unit for base count"
        }
      }
    },
    "timing": {
      "type": "object",
      "properties": {
        "prepMinutes": {
          "type": "integer",
          "description": "Preparation time in minutes"
        },
        "cookMinutes": {
          "type": "integer",
          "description": "Cooking time in minutes"
        },
        "totalMinutes": {
          "type": "integer",
          "description": "Total time in minutes"
        }
      },
      "description": "Timing object (optional)"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "amount", "unit"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Ingredient ID"
          },
          "name": {
            "type": "string",
            "description": "Ingredient name"
          },
          "amount": {
            "type": "number",
            "description": "Amount relative to servings.base"
          },
          "unit": {
            "type": "string",
            "enum": ["g", "kg", "ml", "l", "tsp", "tbsp", "piece", "pinch"],
            "description": "Unit from closed enum"
          },
          "notes": {
            "type": ["string", "null"],
            "description": "Optional ingredient notes"
          }
        }
      },
      "description": "List of ingredients"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "text"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Step ID"
          },
          "order": {
            "type": "integer",
            "description": "Step order number"
          },
          "title": {
            "type": "string",
            "description": "Short title for quick reference (e.g., 'Soften onions'), displayed alongside step number and when collapsed"
          },
          "text": {
            "type": "string",
            "description": "Step description"
          },
          "timer": {
            "type": ["object", "null"],
            "properties": {
              "durationSeconds": {
                "type": "integer",
                "description": "Timer duration in seconds"
              },
              "label": {
                "type": "string",
                "description": "Timer label"
              }
            },
            "description": "Optional timer per step"
          },
          "ingredientRefs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Ingredient IDs relevant to this step"
          }
        }
      },
      "description": "List of cooking steps"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    }
  },
  "additionalProperties": false
}